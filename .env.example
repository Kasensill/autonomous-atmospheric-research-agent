# 复制为 .env 后填写真实密钥；不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 可选核验实验开关 VERIFY_THINKING：未设置或 disabled 保持关闭，enabled 仅对报告核验启用。
# 例如 VERIFY_THINKING=enabled；json_mode 不兼容时报错，不自动回退。不记录隐藏思维内容。

# Qwen / DashScope Embedding
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding

# 可选：若 qwen3.7-text-rerank 要求业务空间专用 API 地址，在此填写。
# 未填写时使用 DashScope SDK 的默认地址。
DASHSCOPE_RERANK_BASE_URL=

# Tavily Web Search
TAVILY_API_KEY=
